{
  "cloudflare": {
    "account_id": "00000000000000000000000000000000",
    "api_token_env": "CF_API_TOKEN",
    "zones": [
      {
        "name": "example.com",
        "zone_id": "00000000000000000000000000000000",
        "workers": ["my-worker"]
      }
    ]
  },
  "schedule": {
    "intraday_interval": "1h",
    "intraday_offset": "7m",
    "settle_delay": "3m",
    "daily_report_at": "08:00",
    "timezone": "Asia/Shanghai",
    "max_parallel_zones": 4
  },
  "thresholds": {
    "total_up_pct": 35,
    "worker_calls_up_pct": 35,
    "cpu_p50_up_pct": 25,
    "dynamic_up_pct": 50,
    "origin_5xx_multiplier": 3,
    "origin_5xx_min": 50,
    "new_face_min_count": 5000,
    "collapse_down_pct": 50,
    "min_count": 1000,
    "escalation_pct": 25,
    "recovery_clean_rounds": 2
  },
  "path_rules": [
    { "name": "login", "path": "/login*", "up_pct": 100, "min_count": 20, "dynamic_only": false }
  ],
  "daily": {
    "paths": [
      { "label": "login origin reach", "path": "/login*", "max": 0 }
    ],
    "artifacts": []
  },
  "known_faces": {
    "asns": [],
    "user_agents": []
  },
  "report": { "language": "en", "visuals": true },
  "rule_names": {},
  "asn_names": {},
  "waf_audit": {
    "disabled": false,
    "hosts": [],
    "sensitive_paths": ["/admin*", "/wp-login.php"]
  },
  "notify": {
    "webhook_url_env": "FLAREHOUND_WEBHOOK_URL",
    "telegram_bot_token_env": "",
    "telegram_chat_id": "",
    "jsonl_file": "",
    "slack_webhook_url_env": "",
    "discord_webhook_url_env": "",
    "wecom_webhook_url_env": "",
    "feishu_webhook_url_env": "",
    "feishu_secret_env": "",
    "heartbeat_url_env": ""
  },
  "state_file": "data/state.json",
  "blocking": {
    "write_token_env": "CF_WRITE_TOKEN",
    "never_block": [],
    "never_block_asns": []
  },
  "archive": {
    "disabled": false,
    "file": "data/archive.db",
    "hourly_retention_days": 400
  },
  "console": {
    "enabled": false,
    "listen": "127.0.0.1:8640",
    "base_url": "",
    "refresh_seconds": 300,
    "session_hours": 12,
    "require_totp": false,
    "trusted_proxies": []
  }
}
